{
  "name": "bundle-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/bin/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "note:create": "tsx src/bin/Modules/Notes/createNote.ts",
    "note:list": "tsx src/bin/Modules/Notes/listNotes.ts",
    "note:archive": "tsx src/bin/Modules/Notes/archiveNote.ts"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "awilix": "^13.0.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "superjson": "^2.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
